{
  "name": "argentina-market-tracker-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:e2e": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "next build && node ./scripts/run-e2e.mjs",
    "test:e2e:run": "node ./scripts/run-e2e.mjs",
    "test:e2e:ssr": "next build && node ./scripts/run-e2e.mjs --mode=ssr --grep @ssr-boot",
    "test:e2e:ui": "playwright test --ui",
    "type-check": "tsc --noEmit",
    "validate:local": "npm run lint && npm run type-check && npm run test && npm run build",
    "validate": "npm run validate:local && npm run test:e2e:run",
    "deps:update": "npx npm-check-updates -u && npm install"
  },
  "dependencies": {
    "lightweight-charts": "^5.2.0",
    "next": "16.2.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "swr": "2.4.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@playwright/test": "^1.59.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.12",
    "tailwindcss": "^4.2.4",
    "typescript": "6.0.3",
    "vitest": "^4.1.5"
  }
}
