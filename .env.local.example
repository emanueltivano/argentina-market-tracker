# Market data source:
# - demo: deterministic fixture data, no upstream credentials required
# - live: real upstream API with credentials
#
# For public portfolio deploys on Vercel, "demo" is the recommended default.
MARKET_DATA_SOURCE="demo"

# Required only in live mode.
# External market API base URL (no trailing slash).
# Example: https://api.example.com
API_URL="https://api.example.com"

# Optional in local development.
# Required for a public deploy if you want metadata/Open Graph to resolve to the
# real public origin instead of relying on platform fallbacks.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional token endpoint path (joined to API_URL). Live mode only.
TOKEN_ENDPOINT="token"

# External API credentials. Live mode only.
# Keep real values in .env.local and Vercel Environment Variables only.
API_USERNAME="your_api_username"
API_PASSWORD="your_api_password"

# Required panel endpoints. Live mode only.
PANEL_LIDER_ENDPOINT="api/v2/cotizaciones/acciones/merval/argentina"
PANEL_GENERAL_ENDPOINT="api/v2/cotizaciones/acciones/panel%20general/argentina"
PANEL_CEDEARS_ENDPOINT="api/v2/cotizaciones/acciones/cedears/argentina"

# Localhost debug only. Keep disabled in production and on public demos.
# /api/token and /api/panel?raw=1 also require a local host.
ENABLE_TOKEN_DEBUG=0

# Optional app version string exposed by /api/health.
# Useful for Vercel or CI/CD deploy metadata.
APP_VERSION=""

# Optional favorites quote fan-out concurrency for /api/favorites.
# Valid range: 1-10. Default: 4.
FAVORITES_QUOTE_CONCURRENCY="4"

# Optional production-only token for GET /api/debug/metrics.
# Leave empty to keep the endpoint disabled in production.
OBSERVABILITY_DEBUG_TOKEN=""

# Rate limiting strategy:
# - local/dev/test defaults to memory buckets
# - production should prefer redis-rest with a trusted edge proxy
# - if redis-rest is not configured in production, the app falls back to
#   process-local memory buckets and a conservative shared client key
#
# Valid values: auto | memory | redis-rest
RATE_LIMIT_STORE="auto"

# Valid values: none | vercel
# In production on Vercel you can set this to "vercel" to trust platform-owned
# forwarded IP headers instead of user-controlled headers.
RATE_LIMIT_TRUSTED_PROXY="none"

# Optional distributed storage for production-ready rate limiting.
# Upstash Redis / Vercel KV REST-compatible endpoint and token.
RATE_LIMIT_REDIS_REST_URL=""
RATE_LIMIT_REDIS_REST_TOKEN=""
