# Required back-end API base URL (no trailing slash)
API_URL="https://api.ejemplo.com"

# Optional token endpoint path (joined to API_URL)
TOKEN_ENDPOINT="token"

# Credentials for Password Grant (development or sandbox account)
API_USERNAME="user_dev"
API_PASSWORD="pass_dev"

# Required
PANEL_LIDER_ENDPOINT=api/v2/cotizaciones/acciones/merval/argentina
PANEL_GENERAL_ENDPOINT=api/v2/cotizaciones/acciones/panel%20general/argentina
PANEL_CEDEARS_ENDPOINT=api/v2/cotizaciones/acciones/cedears/argentina

# Local debug only
ENABLE_TOKEN_DEBUG=0

# Optional: your public app origin for Server Actions in production
NEXT_PUBLIC_APP_ORIGIN="https://tu-dominio.com"