# Required external API base URL (no trailing slash)
API_URL="https://api.example.com"

# Optional token endpoint path (joined to API_URL)
TOKEN_ENDPOINT="token"

# External API credentials. Do not commit real values.
API_USERNAME="your_api_username"
API_PASSWORD="your_api_password"

# Required panel endpoints
PANEL_LIDER_ENDPOINT="api/v2/cotizaciones/acciones/merval/argentina"
PANEL_GENERAL_ENDPOINT="api/v2/cotizaciones/acciones/panel%20general/argentina"
PANEL_CEDEARS_ENDPOINT="api/v2/cotizaciones/acciones/cedears/argentina"

# Localhost debug only. Keep disabled in production.
# /api/token and /api/panel?raw=1 also require a local host.
ENABLE_TOKEN_DEBUG=0
